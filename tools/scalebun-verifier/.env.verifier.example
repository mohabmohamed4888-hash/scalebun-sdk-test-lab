# SERVER-SIDE credentials for tools/scalebun-verifier ONLY.
# Copy to .env.verifier (gitignored). NEVER import this file from React Native
# code, never commit it, never paste its values into the app's .env.

# Personal access token (scalebun_pat_…) from the ScaleBun dashboard.
SCALEBUN_TOKEN=
# Must include /api/v1.
SCALEBUN_API_URL=https://api.scalebun.com/api/v1
# The Test Lab app (same value as SCALEBUN_APP_ID in the app's .env).
SCALEBUN_APP_ID=
SCALEBUN_ORG_ID=
