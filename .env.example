# ScaleBun SDK Test Lab — CLIENT-SAFE configuration (bundled into the app).
# Copy to .env and fill in. Restart Metro with --reset-cache after changes.
#
# NEVER put here: server secrets (…_sk_…), personal access tokens (scalebun_pat_…),
# APNs .p8 keys, Firebase service-account JSON, or OTA signing keys. The app
# REJECTS values that look like secrets and runs in NOT_CONFIGURED mode.
# Server-side verification uses tools/scalebun-verifier/.env.verifier instead.

# ── ScaleBun SaaS credentials (dashboard → App → Environment "development") ──
SCALEBUN_APP_ID=
# SDK *client* key for the development environment (contains "_ck_").
SCALEBUN_CLIENT_KEY=
# Optional labels shown on the Home screen.
SCALEBUN_ENVIRONMENT=development
SCALEBUN_PROJECT_NAME=SDK Test Lab

# ── Legacy handshake credentials (README quick-start shape) — optional ────────
# Only used by the "legacy-credentials" profile (INIT-011) and passed alongside
# SaaS credentials in other profiles when set.
SCALEBUN_PROJECT_ID=
SCALEBUN_PUBLISHABLE_KEY=

# ── OTA ───────────────────────────────────────────────────────────────────────
# Dedicated NON-production channel. Test bundles are published here only.
SCALEBUN_OTA_CHANNEL=sdk-test
SCALEBUN_OTA_ENABLED=false

# ── Deterministic network test server (npm run network-server) ────────────────
# Android emulator: http://10.0.2.2:4545 · iOS simulator: http://localhost:4545
# Physical device: http://<your-LAN-IP>:4545 (printed by the server on start)
NETWORK_TEST_SERVER_URL=http://10.0.2.2:4545

# ── Desktop debugger (optional, DIAGNOSTIC-ONLY) ──────────────────────────────
SCALEBUN_DESKTOP_DEBUG_HOST=

# ── Dangerous tests in RELEASE builds (debug builds always allow them) ────────
# Set to true ONLY for internal QA release builds. Never for store builds.
ENABLE_DANGEROUS_TESTS=false
