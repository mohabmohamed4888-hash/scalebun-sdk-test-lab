# ── ScaleBun SDK Test Lab: secrets & local config ─────────────────────────────
# Client-safe values only, but still per-developer.
.env
.env.*
!.env.example
!**/.env.verifier.example
# Server-side verifier secret — must NEVER be bundled into the app.
tools/scalebun-verifier/.env.verifier
# Firebase / APNs / signing material
android/app/google-services.json
ios/GoogleService-Info.plist
ios/**/GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
*service-account*.json
# ScaleBun OTA signing keys (scalebun ota keys generate writes here)
.scalebun/
*.pem
# Test Lab exported reports can contain device identifiers
reports/
tools/**/node_modules/
.tmp/
