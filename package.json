{
  "name": "scalebun-sdk-test-lab",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode release",
    "ios": "react-native run-ios",
    "ios:release": "react-native run-ios --mode Release",
    "pods": "cd ios && bundle exec pod install",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "test": "jest",
    "test:tools": "node tools/network-test-server/server.test.js && node tools/scalebun-verifier/verify.test.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:tools && npm run bundle:check",
    "bundle:check": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/check/index.android.bundle --assets-dest build/check && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/check/main.jsbundle --assets-dest build/check",
    "doctor": "scalebun doctor",
    "doctor:android": "scalebun init android --check",
    "doctor:ios": "scalebun init ios --check",
    "network-server": "node tools/network-test-server/server.js",
    "verifier:auth": "node tools/scalebun-verifier/verify.js auth",
    "verifier:checklist": "node tools/scalebun-verifier/verify.js checklist",
    "ota:publish:android": "bash scripts/ota-publish-test.sh android",
    "ota:publish:ios": "bash scripts/ota-publish-test.sh ios",
    "e2e:maestro": "maestro test .maestro",
    "docs:coverage": "jest --testMatch \"<rootDir>/scripts/*.gen.ts\" --testPathIgnorePatterns /node_modules/"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-native/new-app-screen": "0.81.6",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@scalebun/react-native": "2.4.0",
    "axios": "^1.20.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-device-info": "^14.1.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "~4.24.0",
    "react-native-view-shot": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
